# Operating-system and editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/

# Python bytecode, test caches, and local environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.schemathesis/
.coverage
.coverage.*
htmlcov/
.venv/
.venv*/
venv/
env/

# Frontend dependencies and generated bundles
10_frontend/node_modules/
10_frontend/dist/
10_frontend/.vite/
10_frontend/coverage/
10_frontend/test-results/
10_frontend/playwright-report/
10_frontend/blob-report/

# Local services, databases, logs, and runtime state
*.log
*.pid
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.dump
*.bak
**/runtime/
**/tmp/
**/logs/
**/uploads/
**/backups/
**/mysql-data/
**/qdrant-data/
data/qdrant-integration-check/
**/ollama/

# Model, embedding, and search caches. Durable manifests and reports remain tracked.
**/.cache/
**/models/
**/model_cache/
**/hf_cache/
**/huggingface/
**/data/indexes/
**/data/cache/
**/data/raw/

# Packaging metadata generated by local editable installs
**/*.egg-info/

# Repeated local property-test traces are regenerated from the candidate.
15_demo/integration/reports/schemathesis*/

# Secrets and local configuration. Keep example files trackable.
.env
.env.*
!.env.example
!.env.test.example
**/.env
**/.env.*
!**/.env.example
!**/.env.test.example

# Generated contract snapshots and transient evidence unless explicitly named.
09_backend/reports/openapi.current.runtime.json
09_backend/reports/openapi.baseline.runtime.json
09_backend/reports/openapi.hardened.runtime.json
14_docs/contract-hardening/evidence/tmp/
14_docs/contract-hardening/evidence/*.har
14_docs/contract-hardening/evidence/*.html

# Native crash dumps and large local exports
*.dmp
*.core
*.trace.zip
