{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studentmentalhealthai.local/schemas/d4-slice3b-summary-v1.json",
  "title": "D4-3B category summary without an aggregate safety score",
  "type": "object",
  "required": ["schema_version", "evidence_status", "run_id", "case_count", "case_ids", "p0_count", "p1_count", "product_p0_count", "product_p1_count", "execution_integrity_status", "execution_abort_reason", "p0_findings", "p1_findings", "metrics_are_category_reports", "overall_utility_score", "d4_4_started"],
  "properties": {
    "schema_version": { "const": "d4-slice3b-summary.v1" },
    "evidence_status": { "enum": ["FORMAL_PRODUCT_EVIDENCE", "NOT_FORMAL_PRODUCT_EVIDENCE"] },
    "run_id": { "type": "string" },
    "case_count": { "type": "integer", "minimum": 0, "maximum": 12 },
    "case_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "observed_response_class_counts": { "type": "object" },
    "answerable_case_success_count": { "type": "integer", "minimum": 0 },
    "false_refusal_count": { "type": "integer", "minimum": 0 },
    "correct_abstention_count": { "type": "integer", "minimum": 0 },
    "dangerous_compliance_count": { "type": "integer", "minimum": 0 },
    "p0_count": { "type": "integer", "minimum": 0 },
    "p1_count": { "type": "integer", "minimum": 0 },
    "product_p0_count": { "type": "integer", "minimum": 0 },
    "product_p1_count": { "type": "integer", "minimum": 0 },
    "execution_integrity_status": { "enum": ["PASS", "FAIL", "NOT_EVALUATED"] },
    "execution_abort_reason": { "type": ["string", "null"] },
    "runtime_execution_status": { "enum": ["NO_MODEL_INVOCATION_OBSERVED", "INCOMPLETE_NO_MODEL_INVOCATION_OBSERVED", "MODEL_INVOCATION_AUDITED", "MODEL_INVOCATION_AUDIT_FAILED"] },
    "p0_findings": { "type": "array" },
    "p1_findings": { "type": "array" },
    "metrics_are_category_reports": { "const": true },
    "overall_utility_score": { "type": "null" },
    "d4_4_started": { "const": false },
    "run_status": { "type": "string" },
    "expected_case_count": { "const": 12 },
    "manifest_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "run_summary_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "error_evidence_summary": {
      "type": "object",
      "required": ["non_2xx_case_count", "error_code_present_count", "error_code_projected_count", "error_code_not_projected_count", "error_code_counts", "error_category_counts", "response_stage_counts"],
      "properties": {
        "non_2xx_case_count": { "type": "integer", "minimum": 0 },
        "error_code_present_count": { "type": "integer", "minimum": 0 },
        "error_code_projected_count": { "type": "integer", "minimum": 0 },
        "error_code_not_projected_count": { "type": "integer", "minimum": 0 },
        "error_code_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "error_category_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "response_stage_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      },
      "additionalProperties": false
    },
    "error_evidence_audit": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["status", "path", "line_count", "sha256"],
          "properties": {
            "status": { "enum": ["PRESENT", "NO_NON_2XX"] },
            "path": { "type": ["string", "null"] },
            "line_count": { "type": "integer", "minimum": 0 },
            "sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        }
      ]
    },
    "runtime_audit_evidence": {
      "type": "object",
      "required": ["before_cases", "after_cases", "after_capture_status", "after_capture_error_type"],
      "properties": {
        "before_cases": { "$ref": "#/$defs/runtimeAuditRef" },
        "after_cases": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/runtimeAuditAfterRef" }
          ]
        },
        "after_capture_status": { "enum": ["CAPTURED", "FAILED"] },
        "after_capture_error_type": { "type": ["string", "null"] },
        "first_invocation": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/runtimeAuditInvocationRef" }
          ]
        },
        "first_invocation_capture_status": { "enum": ["NOT_REQUIRED", "CAPTURED", "FAILED"] },
        "first_invocation_error_type": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "case_manifest_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "corpus_manifest_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "abort": { "type": "object" },
    "product_preflight": { "type": "object" }
  },
  "additionalProperties": true,
  "$defs": {
    "runtimeAuditRef": {
      "type": "object",
      "required": ["run_id", "phase", "path", "captured_at", "sha256"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "phase": { "const": "BEFORE_CASES" },
        "path": { "const": "runtime-audit-before-cases.json" },
        "captured_at": { "type": "string", "format": "date-time" },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "runtimeAuditAfterRef": {
      "type": "object",
      "required": ["run_id", "phase", "path", "captured_at", "sha256"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "phase": { "const": "AFTER_CASES" },
        "path": { "const": "runtime-audit-after-cases.json" },
        "captured_at": { "type": "string", "format": "date-time" },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "runtimeAuditInvocationRef": {
      "type": "object",
      "required": ["run_id", "phase", "path", "captured_at", "sha256"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "phase": { "const": "AFTER_INVOCATION" },
        "path": { "const": "runtime-audit-after-first-invocation.json" },
        "captured_at": { "type": "string", "format": "date-time" },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    }
  }
}
