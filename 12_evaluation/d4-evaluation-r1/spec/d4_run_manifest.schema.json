{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studentmentalhealthai.local/schemas/d4-run-v1.json",
  "title": "D4 machine run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_mode",
    "timestamp",
    "git_commit",
    "accepted_tags",
    "dataset_versions",
    "dataset_hashes",
    "sealed_hash",
    "promptfoo_version",
    "promptfoo_config_hash",
    "provider_identities",
    "runtime",
    "template_ids_hashes",
    "policy_ids_hashes",
    "rag_corpus_identity",
    "seed",
    "repeat_settings",
    "hardware",
    "network_policy",
    "test_groups",
    "result_paths",
    "network_observation",
    "bootstrap_modes",
    "real_student_data",
    "cloud_fallback",
    "retry_policy",
    "human_review_closure",
    "node_runtime",
    "lock_hash",
    "wrapper_identity",
    "endpoint_inventory",
    "fixture_audit",
    "sealed_evaluation"
  ],
  "properties": {
    "schema_version": {
      "const": "d4-run-v1"
    },
    "run_id": {
      "type": "string"
    },
    "run_mode": {
      "enum": [
        "FAST_REGRESSION",
        "FULL_ENGINEERING",
        "SEALED_FINAL"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$"
    },
    "accepted_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataset_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dev",
        "regression",
        "sealed"
      ],
      "properties": {
        "dev": {
          "type": "string"
        },
        "regression": {
          "type": "string"
        },
        "sealed": {
          "type": "string"
        }
      }
    },
    "dataset_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dev",
        "regression",
        "sealed"
      ],
      "properties": {
        "dev": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "regression": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sealed": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sealed_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "promptfoo_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "promptfoo_config_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "attacker",
        "grader"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "attacker": {
          "type": [
            "string",
            "null"
          ]
        },
        "grader": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "digest"
      ],
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "digest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "template_ids_hashes": {
      "type": "object"
    },
    "policy_ids_hashes": {
      "type": "object"
    },
    "rag_corpus_identity": {
      "type": [
        "string",
        "null"
      ]
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "repeat_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repeats",
        "concurrency"
      ],
      "properties": {
        "repeats": {
          "type": "integer",
          "minimum": 1
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "cache": {
          "enum": [
            "disabled",
            "enabled"
          ]
        },
        "retry_policy": {
          "type": "string"
        }
      }
    },
    "hardware": {
      "type": "object"
    },
    "network_policy": {
      "enum": [
        "loopback_only",
        "observed_loopback_only",
        "controller_exception"
      ]
    },
    "test_groups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "real_student_data": {
      "const": false
    },
    "cloud_fallback": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "network_observation": {
      "enum": [
        "NOT_RUN",
        "observed_loopback_only",
        "non_loopback_detected",
        "controller_exception"
      ]
    },
    "bootstrap_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "exact_d3_fixture",
          "legacy_compatibility_fixture"
        ]
      },
      "uniqueItems": true,
      "maxItems": 1
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_retries",
        "non_idempotent_post_retries"
      ],
      "properties": {
        "max_retries": {
          "type": "integer",
          "minimum": 0
        },
        "non_idempotent_post_retries": {
          "const": 0
        }
      }
    },
    "human_review_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "mandatory_complete",
        "unresolved_count",
        "disagreement_preserved"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_RUN",
            "PENDING",
            "COMPLETE",
            "ESCALATED"
          ]
        },
        "mandatory_complete": {
          "type": "boolean"
        },
        "unresolved_count": {
          "type": "integer",
          "minimum": 0
        },
        "disagreement_preserved": {
          "type": "boolean"
        }
      }
    },
    "node_runtime": {
      "type": [
        "string",
        "null"
      ]
    },
    "lock_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "wrapper_identity": {
      "type": [
        "string",
        "null"
      ]
    },
    "endpoint_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "endpoint",
          "approved"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "endpoint": {
            "type": "string",
            "minLength": 1
          },
          "approved": {
            "type": "boolean"
          }
        }
      }
    },
    "fixture_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_mode",
        "source_identity",
        "target_identity",
        "compatibility_mapping",
        "separation_rule"
      ],
      "properties": {
        "fixture_mode": {
          "enum": [
            "exact_d3_fixture",
            "legacy_compatibility_fixture"
          ]
        },
        "source_identity": {
          "type": "string"
        },
        "target_identity": {
          "type": "string"
        },
        "compatibility_mapping": {
          "type": "string"
        },
        "separation_rule": {
          "const": "one_mode_per_run"
        }
      }
    },
    "sealed_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "case_count",
        "scenario_family_distribution",
        "creation_provenance",
        "approval_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_RUN",
            "PENDING",
            "COMPLETE"
          ]
        },
        "case_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "scenario_family_distribution": {
          "type": "object"
        },
        "creation_provenance": {
          "type": "string"
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "run_mode": {
            "const": "SEALED_FINAL"
          }
        }
      },
      "then": {
        "required": [
          "sealed_hash",
          "promptfoo_version",
          "promptfoo_config_hash",
          "human_review_closure",
          "node_runtime",
          "lock_hash",
          "wrapper_identity",
          "endpoint_inventory",
          "fixture_audit",
          "sealed_evaluation"
        ],
        "properties": {
          "sealed_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "promptfoo_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "promptfoo_config_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "network_observation": {
            "const": "observed_loopback_only"
          },
          "bootstrap_modes": {
            "minItems": 1
          },
          "human_review_closure": {
            "type": "object",
            "properties": {
              "status": {
                "const": "COMPLETE"
              },
              "mandatory_complete": {
                "const": true
              },
              "unresolved_count": {
                "const": 0
              },
              "disagreement_preserved": {
                "const": true
              }
            }
          },
          "node_runtime": {
            "type": "string",
            "minLength": 1
          },
          "lock_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "wrapper_identity": {
            "type": "string",
            "minLength": 1
          },
          "endpoint_inventory": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "endpoint",
                "approved"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "endpoint": {
                  "type": "string",
                  "pattern": "^(https?://)?(127\\.0\\.0\\.1|localhost|\\[?::1\\]?)(:[0-9]+)?(/.*)?$"
                },
                "approved": {
                  "const": true
                }
              }
            }
          },
          "provider_identities": {
            "type": "object",
            "required": [
              "target",
              "attacker",
              "grader"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "attacker": {
                "type": "string",
                "minLength": 1
              },
              "grader": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "runtime": {
            "type": "object",
            "required": [
              "model",
              "digest"
            ],
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "network_policy": {
            "const": "observed_loopback_only"
          },
          "fixture_audit": {
            "type": "object",
            "properties": {
              "separation_rule": {
                "const": "one_mode_per_run"
              }
            }
          },
          "sealed_evaluation": {
            "type": "object",
            "required": [
              "status",
              "case_count",
              "approval_ref"
            ],
            "properties": {
              "status": {
                "const": "COMPLETE"
              },
              "case_count": {
                "type": "integer",
                "minimum": 1
              },
              "approval_ref": {
                "type": "string",
                "minLength": 1
              },
              "scenario_family_distribution": {
                "type": "object",
                "minProperties": 1
              },
              "creation_provenance": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fixture_audit": {
            "properties": {
              "fixture_mode": {
                "const": "exact_d3_fixture"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "bootstrap_modes": {
            "items": {
              "const": "exact_d3_fixture"
            }
          },
          "fixture_audit": {
            "properties": {
              "compatibility_mapping": {
                "const": "none"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fixture_audit": {
            "properties": {
              "fixture_mode": {
                "const": "legacy_compatibility_fixture"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "bootstrap_modes": {
            "items": {
              "const": "legacy_compatibility_fixture"
            }
          },
          "fixture_audit": {
            "properties": {
              "compatibility_mapping": {
                "const": "D3-4_BACKEND_SYNTHETIC_COMPATIBILITY_V1"
              }
            }
          }
        }
      }
    }
  ]
}
