{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studentmentalhealthai.local/schemas/d4-slice3b-case-result-v1.json",
  "title": "D4-3B per-case product or harness evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_status", "run_id", "case_id", "source_packet_id", "source_packet_hash", "expected", "actual", "retrieval_evidence", "citations", "claims", "utility", "fallback", "runtime_identity", "governance", "findings", "result_hash"],
  "properties": {
    "schema_version": { "const": "d4-slice3b-case-result.v1" },
    "evidence_status": { "enum": ["FORMAL_PRODUCT_EVIDENCE", "NOT_FORMAL_PRODUCT_EVIDENCE"] },
    "run_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "pattern": "^AW-[A-Z0-9][A-Z0-9_-]*$" },
    "source_packet_id": { "const": "D4-PACKET-SLICE3A-CITATION-UTILITY-R1" },
    "source_packet_hash": { "const": "sha256:cfbe640300c2cbfbfe9616bb20b10b6ed80e7ee1e15169aadf2052ac8de107c6" },
    "expected": { "type": "object", "required": ["response_class", "expected_route", "population", "role", "purpose", "required_evidence_ids"], "properties": { "response_class": { "enum": ["MUST_ANSWER", "SHOULD_ANSWER", "SHOULD_ABSTAIN", "MUST_ROUTE", "MUST_DENY"] }, "expected_route": { "type": "string" }, "population": { "type": "string" }, "role": { "type": "string" }, "purpose": { "type": "string" }, "required_evidence_ids": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": true },
    "actual": { "type": "object", "required": ["http_status", "request_id", "trace_id", "safety_route", "generation_status", "response_class", "normal_generation", "content"], "properties": { "http_status": { "type": "integer", "minimum": 100, "maximum": 599 }, "support_run_id": { "type": ["string", "null"] }, "generation_id": { "type": ["string", "null"] }, "request_id": { "type": "string" }, "trace_id": { "type": "string" }, "safety_route": { "type": ["string", "null"] }, "generation_status": { "type": ["string", "null"] }, "response_class": { "enum": ["ANSWERED", "ABSTAINED", "ROUTED", "DENIED", "UNKNOWN"] }, "normal_generation": { "type": ["boolean", "null"] }, "content": { "type": ["object", "null"] } }, "additionalProperties": true },
    "retrieval_evidence": { "type": "object", "required": ["query_sha256", "expected_target_population", "requested_target_population", "observed_target_population", "population_mapping_status", "population_observation_source", "retrieved_chunk_ids", "retrieved_source_chunk_ids", "evaluation_to_source_evidence", "document_ids", "source_ids", "content_hashes", "retrieval_status", "rag_call_count", "corpus_identity"], "properties": { "query_sha256": { "$ref": "#/$defs/hash" }, "expected_target_population": { "type": ["string", "null"] }, "requested_target_population": { "type": ["string", "null"] }, "observed_target_population": { "type": ["string", "null"] }, "population_mapping_status": { "enum": ["MATCH", "MISMATCH", "NOT_OBSERVED"] }, "population_observation_source": { "type": "string" }, "retrieved_chunk_ids": { "type": "array", "items": { "type": "string" } }, "retrieved_source_chunk_ids": { "type": "array", "items": { "type": "string" } }, "evaluation_to_source_evidence": { "type": "object", "additionalProperties": { "type": "string" } }, "document_ids": { "type": "array", "items": { "type": "string" } }, "source_ids": { "type": "array", "items": { "type": "string" } }, "content_hashes": { "type": "array", "items": { "type": "string" } }, "retrieval_status": { "type": "string" }, "rag_call_count": { "type": "integer", "minimum": 0 }, "corpus_identity": { "type": ["object", "null"] } }, "additionalProperties": false },
    "citations": { "type": "object", "required": ["cited_chunk_ids", "cited_source_chunk_ids", "unmapped_evaluation_chunk_ids", "cited_document_ids", "unknown_chunk_ids", "outside_approved_allowlist", "orphan_retrieved_chunk_ids", "fabricated"], "properties": { "cited_chunk_ids": { "type": "array", "items": { "type": "string" } }, "cited_source_chunk_ids": { "type": "array", "items": { "type": "string" } }, "unmapped_evaluation_chunk_ids": { "type": "array", "items": { "type": "string" } }, "cited_document_ids": { "type": "array", "items": { "type": "string" } }, "unknown_chunk_ids": { "type": "array", "items": { "type": "string" } }, "outside_approved_allowlist": { "type": "array", "items": { "type": "string" } }, "orphan_retrieved_chunk_ids": { "type": "array", "items": { "type": "string" } }, "fabricated": { "type": "boolean" } }, "additionalProperties": false },
    "claims": { "type": "array", "items": { "type": "object", "required": ["claim_id", "source_case_id", "source_field", "claim_text", "claim_sha256", "cited_chunk_ids", "textual_support", "population_applicability", "role_applicability", "purpose_applicability", "review_status"], "properties": { "claim_id": { "type": "string" }, "source_case_id": { "type": "string" }, "source_field": { "type": "string" }, "claim_text": { "type": "string" }, "claim_sha256": { "$ref": "#/$defs/hash" }, "cited_chunk_ids": { "type": "array", "items": { "type": "string" } }, "textual_support": { "enum": ["SUPPORTS", "PARTIALLY_SUPPORTS", "UNSUPPORTED", "CONTRADICTS", "OUT_OF_SCOPE", "PENDING_HUMAN_REVIEW"] }, "population_applicability": { "enum": ["MATCH", "MISMATCH", "UNRESOLVED", "PENDING_HUMAN_REVIEW"] }, "role_applicability": { "enum": ["MATCH", "MISMATCH", "UNRESOLVED", "PENDING_HUMAN_REVIEW"] }, "purpose_applicability": { "enum": ["MATCH", "MISMATCH", "UNRESOLVED", "PENDING_HUMAN_REVIEW"] }, "review_status": { "type": "string" } }, "additionalProperties": true } },
    "utility": { "type": "object", "required": ["outcome", "success", "abstention", "false_refusal", "correct_abstention", "dangerous_compliance", "required_abstention_respected", "required_denial_respected", "required_route_respected", "required_evidence_retrieved"], "properties": { "outcome": { "type": "string" }, "success": { "type": "boolean" }, "abstention": { "type": "boolean" }, "false_refusal": { "type": "boolean" }, "correct_abstention": { "type": "boolean" }, "dangerous_compliance": { "type": "boolean" }, "required_abstention_respected": { "type": "boolean" }, "required_denial_respected": { "type": "boolean" }, "required_route_respected": { "type": "boolean" }, "required_evidence_retrieved": { "type": ["boolean", "null"] } }, "additionalProperties": false },
    "fallback": { "type": "object", "required": ["used", "observation_source"], "properties": { "used": { "type": ["boolean", "null"] }, "observation_source": { "type": "string" } }, "additionalProperties": false },
    "runtime_identity": { "type": "object", "required": ["expected", "preflight_observed", "per_generation_observed", "identity_mismatch"], "properties": { "expected": { "type": "object" }, "preflight_observed": { "type": "object" }, "per_generation_observed": { "type": "array", "items": { "type": "object" } }, "identity_mismatch": { "type": "boolean" } }, "additionalProperties": false },
    "governance": { "type": "object", "required": ["product_source_changed", "human_gold_changed", "contract_changed", "external_network_detected", "real_student_data", "cloud_fallback", "d4_4_started"], "properties": { "product_source_changed": { "type": "boolean" }, "human_gold_changed": { "type": "boolean" }, "contract_changed": { "type": "boolean" }, "external_network_detected": { "type": "boolean" }, "real_student_data": { "type": "boolean" }, "cloud_fallback": { "type": "boolean" }, "d4_4_started": { "const": false } }, "additionalProperties": false },
    "findings": { "type": "array", "items": { "type": "object", "required": ["code", "severity", "evidence"], "properties": { "code": { "type": "string" }, "severity": { "enum": ["P0", "P1"] }, "evidence": { "type": "string" } }, "additionalProperties": false } },
    "result_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
