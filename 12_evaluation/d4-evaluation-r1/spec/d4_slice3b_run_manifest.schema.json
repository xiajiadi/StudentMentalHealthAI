{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studentmentalhealthai.local/schemas/d4-slice3b-run-manifest-v1.json",
  "title": "D4-3B immutable formal run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "run_timestamp", "git_branch", "git_commit", "git_dirty", "git_status_sha256", "git_diff_sha256", "evaluation_source_tree_sha256", "accepted_tags", "accepted_d4_3a_commit", "human_gold_packet_id", "human_gold_packet_hash", "human_gold_packet_file_sha256", "source_provenance", "case_manifest_hash", "approved_case_ids", "citation_reference_case_ids", "runtime_preflight_hash", "runtime_expected_identity", "runtime_observed_identity", "runtime_endpoint_health_identity", "backend_dependency_identity", "managed_service_identity", "backend_identity", "observer_endpoints", "rag_corpus_identity", "safety_identity", "evaluation_mode", "retry_policy", "network_policy", "network_observation", "configuration_audit", "synthetic_only", "real_student_data", "cloud_fallback", "formal_product_requests_allowed", "d4_4_started", "manifest_hash"],
  "properties": {
    "schema_version": { "const": "d4-slice3b-run-manifest.v1" },
    "run_id": { "type": "string", "pattern": "^D4RUN-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "run_timestamp": { "type": "string", "format": "date-time" },
    "git_branch": { "type": "string", "minLength": 1 },
    "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "git_dirty": { "type": "boolean" },
    "git_status_sha256": { "$ref": "#/$defs/hash" },
    "git_diff_sha256": { "$ref": "#/$defs/hash" },
    "evaluation_source_tree_sha256": { "$ref": "#/$defs/hash" },
    "accepted_tags": { "const": ["d4-slice3a-r1-accepted"] },
    "accepted_d4_3a_commit": { "const": "dd083d7a9d50e554408571e8b6d8040700d7a88b" },
    "human_gold_packet_id": { "const": "D4-PACKET-SLICE3A-CITATION-UTILITY-R1" },
    "human_gold_packet_hash": { "const": "sha256:cfbe640300c2cbfbfe9616bb20b10b6ed80e7ee1e15169aadf2052ac8de107c6" },
    "human_gold_packet_file_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_provenance": { "type": "object" },
    "case_manifest_hash": { "$ref": "#/$defs/hash" },
    "approved_case_ids": { "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true, "items": { "type": "string" } },
    "citation_reference_case_ids": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": { "type": "string" } },
    "runtime_preflight_hash": { "$ref": "#/$defs/hash" },
    "runtime_expected_identity": { "$ref": "#/$defs/runtimeIdentity" },
    "runtime_observed_identity": { "$ref": "#/$defs/runtimeIdentity" },
    "runtime_endpoint_health_identity": { "type": "object", "required": ["readiness", "cloud_fallback"], "properties": { "readiness": { "const": "pass" }, "cloud_fallback": { "const": false }, "state": { "type": ["string", "null"] }, "runtime_version": { "type": ["string", "null"] }, "models": { "type": "object" }, "provider_ids": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
    "backend_dependency_identity": { "type": "object", "required": ["cat", "rag", "llm_runtime", "safety"], "properties": { "cat": { "$ref": "#/$defs/dependency" }, "rag": { "$ref": "#/$defs/dependency" }, "llm_runtime": { "$ref": "#/$defs/dependency" }, "safety": { "$ref": "#/$defs/dependency" } }, "additionalProperties": false },
    "managed_service_identity": {
      "type": "object",
      "required": ["owner", "runtime_process_owned", "services"],
      "properties": {
        "owner": { "type": "string" },
        "runtime_process_owned": { "type": "boolean" },
        "cleanup_policy": { "type": "string" },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "pid", "parent_pid", "process_tree_pids", "executable", "executable_sha256", "argv_redacted", "cwd", "command_sha256", "readiness_url", "log_path", "started_at", "health", "ownership", "interpreter_version", "package_lock_identity"],
            "properties": {
              "name": { "type": "string" },
              "pid": { "type": "integer", "minimum": 1 },
              "parent_pid": { "type": "integer", "minimum": 1 },
              "process_tree_pids": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
              "executable": { "type": "string" },
              "executable_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "argv_redacted": { "type": "array", "items": { "type": "string" } },
              "cwd": { "type": "string" },
              "command_sha256": { "$ref": "#/$defs/hash" },
              "readiness_url": { "type": "string" },
              "log_path": { "type": "string" },
              "started_at": { "type": "string", "format": "date-time" },
              "health": { "type": "object" },
              "ownership": { "type": "string" },
              "interpreter_version": { "type": ["string", "null"] },
              "package_lock_identity": { "type": "object", "additionalProperties": { "type": "string" } }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "owner": { "const": "D4_EVALUATION_HARNESS" } }, "required": ["owner"] },
          "then": { "properties": { "runtime_process_owned": { "const": true }, "services": { "minItems": 10 } } }
        }
      ],
      "additionalProperties": false
    },
    "backend_identity": { "type": "object", "required": ["base_url", "method", "route", "transport", "module_endpoints_loopback_only"], "properties": { "base_url": { "type": "string", "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\])" }, "method": { "const": "POST" }, "route": { "const": "/api/v1/support/requests" }, "transport": { "const": "CANONICAL_HTTP" }, "module_endpoints_loopback_only": { "const": true } }, "additionalProperties": false },
    "observer_endpoints": { "type": "object", "required": ["rag", "llm"], "properties": { "rag": { "type": "string" }, "llm": { "type": "string" } }, "additionalProperties": false },
    "rag_corpus_identity": { "type": "object", "required": ["corpus_id", "corpus_hash", "evidence_ids", "rag_service", "source_packet_id", "source_packet_hash"], "properties": { "corpus_id": { "type": "string" }, "corpus_hash": { "$ref": "#/$defs/hash" }, "evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "rag_service": { "type": "object" }, "source_packet_id": { "type": "string" }, "source_packet_hash": { "$ref": "#/$defs/hash" } }, "additionalProperties": false },
    "safety_identity": { "type": "object", "required": ["source", "integration", "status"], "properties": { "source": { "type": "string" }, "integration": { "type": "string" }, "status": { "type": "string" } }, "additionalProperties": false },
    "evaluation_mode": { "const": "FORMAL_PRODUCT_EVALUATION" },
    "retry_policy": { "const": { "max_retries": 0, "non_idempotent_post_retries": 0 } },
    "network_policy": { "const": "LOOPBACK_ONLY" },
    "network_observation": { "const": "OBSERVED_LOOPBACK_ONLY" },
    "configuration_audit": { "type": "object", "required": ["expected", "unexpected"], "properties": { "expected": { "type": "object" }, "unexpected": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
    "synthetic_only": { "const": true },
    "real_student_data": { "const": false },
    "cloud_fallback": { "const": false },
    "formal_product_requests_allowed": { "const": true },
    "d4_4_started": { "const": false },
    "manifest_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "dependency": { "type": "object", "required": ["status", "integration"], "properties": { "status": { "const": "READY" }, "integration": { "const": "REAL_HTTP" } }, "additionalProperties": true },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ollama_version", "model", "digest", "num_ctx", "kv_cache_type", "num_parallel", "max_loaded_models", "output_budget", "cloud_fallback", "endpoint"],
      "properties": {
        "ollama_version": { "const": "0.33.3" },
        "model": { "const": "qwen2.5:7b-instruct-q4_K_M" },
        "digest": { "const": "845dbda0ea48ed749caafd9e6037047aa19acfcfd82e704d7ca97d631a0b697e" },
        "num_ctx": { "const": 8192 },
        "kv_cache_type": { "const": "f16" },
        "num_parallel": { "const": 1 },
        "max_loaded_models": { "const": 1 },
        "output_budget": { "const": 768 },
        "cloud_fallback": { "const": false },
        "endpoint": { "type": "string", "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\])" }
      }
    }
  }
}
