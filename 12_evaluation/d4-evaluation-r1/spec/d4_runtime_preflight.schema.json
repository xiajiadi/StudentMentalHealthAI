{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studentmentalhealthai.local/schemas/d4-runtime-preflight-v1.json",
  "title": "Exact accepted local Runtime preflight for D4-3B",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "observed_at", "runtime_identity", "network_observation", "external_network_detected", "cloud_fallback", "preflight_hash"],
  "properties": {
    "schema_version": { "const": "d4-runtime-preflight.v1" },
    "status": { "const": "PASS" },
    "observed_at": { "type": "string", "format": "date-time" },
    "runtime_identity": { "$ref": "#/$defs/runtimeIdentity" },
    "network_observation": { "const": "OBSERVED_LOOPBACK_ONLY" },
    "external_network_detected": { "const": false },
    "cloud_fallback": { "const": false },
    "preflight_hash": { "$ref": "#/$defs/hash" },
    "execution_binding": { "$ref": "#/$defs/executionBinding" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "executionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "attempt_id", "observed_at", "runtime_pid", "runtime_process_tree_pids",
        "runtime_started_at", "runtime_executable", "runtime_executable_sha256", "runtime_launcher_pid",
        "runtime_launcher_started_at", "runtime_launcher_executable", "runtime_launcher_executable_sha256",
        "runtime_source_tree_sha256",
        "runtime_endpoint", "ollama_pid", "ollama_process_tree_pids", "ollama_started_at",
        "ollama_executable", "ollama_executable_sha256", "provider_endpoint", "ollama_version", "model",
        "model_digest", "num_ctx", "kv_cache_type", "num_parallel", "max_loaded_models", "output_budget",
        "cloud_fallback", "network_status", "network_observation", "external_established_connection_count",
        "forbidden_endpoint_connection_count", "verified_listener_pids", "network_observation_sha256"
      ],
      "properties": {
        "schema_version": { "const": "d4-runtime-live-attestation.v1" },
        "attempt_id": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "runtime_pid": { "type": "integer", "minimum": 1 },
        "runtime_process_tree_pids": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
        "runtime_started_at": { "type": "string", "format": "date-time" },
        "runtime_executable": { "type": "string", "minLength": 1 },
        "runtime_executable_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runtime_launcher_pid": { "type": "integer", "minimum": 1 },
        "runtime_launcher_started_at": { "type": "string", "format": "date-time" },
        "runtime_launcher_executable": { "type": "string", "minLength": 1 },
        "runtime_launcher_executable_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runtime_source_tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runtime_endpoint": { "const": "http://127.0.0.1:8160" },
        "ollama_pid": { "type": "integer", "minimum": 1 },
        "ollama_process_tree_pids": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
        "ollama_started_at": { "type": "string", "format": "date-time" },
        "ollama_executable": { "type": "string", "minLength": 1 },
        "ollama_executable_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "provider_endpoint": { "const": "http://127.0.0.1:11437" },
        "ollama_version": { "const": "0.33.3" },
        "model": { "const": "qwen2.5:7b-instruct-q4_K_M" },
        "model_digest": { "const": "845dbda0ea48ed749caafd9e6037047aa19acfcfd82e704d7ca97d631a0b697e" },
        "num_ctx": { "const": 8192 },
        "kv_cache_type": { "const": "f16" },
        "num_parallel": { "const": 1 },
        "max_loaded_models": { "const": 1 },
        "output_budget": { "const": 768 },
        "cloud_fallback": { "const": false },
        "network_status": { "const": "PASS" },
        "network_observation": { "const": "OBSERVED_LOOPBACK_ONLY" },
        "external_established_connection_count": { "const": 0 },
        "forbidden_endpoint_connection_count": { "const": 0 },
        "verified_listener_pids": {
          "type": "object",
          "required": ["3307", "8160", "8180", "8181", "8190", "11437"],
          "patternProperties": { "^[0-9]{4,5}$": { "type": "integer", "minimum": 1 } },
          "additionalProperties": false
        },
        "network_observation_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ollama_version", "model", "digest", "num_ctx", "kv_cache_type", "num_parallel", "max_loaded_models", "output_budget", "cloud_fallback", "endpoint"],
      "properties": {
        "ollama_version": { "const": "0.33.3" },
        "model": { "const": "qwen2.5:7b-instruct-q4_K_M" },
        "digest": { "const": "845dbda0ea48ed749caafd9e6037047aa19acfcfd82e704d7ca97d631a0b697e" },
        "num_ctx": { "const": 8192 },
        "kv_cache_type": { "const": "f16" },
        "num_parallel": { "const": 1 },
        "max_loaded_models": { "const": 1 },
        "output_budget": { "const": 768 },
        "cloud_fallback": { "const": false },
        "endpoint": { "type": "string", "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\])" }
      }
    }
  }
}
