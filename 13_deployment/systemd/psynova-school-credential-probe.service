[Unit]
Description=Verify encrypted systemd credential injection for PsyNova

[Service]
Type=oneshot
RemainAfterExit=yes
User=psynova-school-demo
Group=psynova-school-demo
WorkingDirectory=/opt/psynova-school-demo/release
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/psynova-school-demo/release/13_deployment:/opt/psynova-school-demo/release/09_backend/src:/opt/psynova-school-demo/release/11_database
Environment=DATABASE_KEY_FILE=database-keys.json
LoadCredentialEncrypted=database-keys.json:/etc/credstore.encrypted/psynova-school-database-keys.cred
ExecStart=/opt/psynova-school-demo/venv/bin/python /opt/psynova-school-demo/release/13_deployment/probe_systemd_credentials.py --repo-root /opt/psynova-school-demo/release
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
