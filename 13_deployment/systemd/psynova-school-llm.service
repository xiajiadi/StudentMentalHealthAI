[Unit]
Description=PsyNova synthetic school DeepSeek runtime
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/psynova-school-demo/release/06_llm-runtime
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/psynova-school-demo/release/06_llm-runtime/src
Environment=SMHAI_LLM_PROVIDER=deepseek
Environment=SMHAI_LLM_PORT=8160
Environment=SMHAI_LLM_RUNTIME_AUTH_FILE=%d/llm-runtime-auth.json
LoadCredentialEncrypted=deepseek-api-key:/etc/credstore.encrypted/psynova-school-deepseek-api-key.cred
LoadCredentialEncrypted=llm-runtime-auth.json:/etc/credstore.encrypted/psynova-school-llm-runtime-auth.cred
ExecStartPre=/opt/psynova-school-demo/venv/bin/python -c "from llm_runtime.api.app import app; print('LLM_CONFIG=PASS')"
ExecStart=/opt/psynova-school-demo/venv/bin/python -m llm_runtime.api.app
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=1536M
CPUQuota=100%
RuntimeDirectory=psynova-school-llm
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
IPAddressAllow=3.173.21.63/32
ReadWritePaths=/run/psynova-school-llm

[Install]
WantedBy=multi-user.target
