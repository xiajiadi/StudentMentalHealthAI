[Unit]
Description=PsyNova synthetic school Safety control plane
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=psynova-school-demo
Group=psynova-school-demo
WorkingDirectory=/opt/psynova-school-demo/services/safety/release
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/psynova-school-demo/services/safety/release/src
Environment=SMHAI_MANAGE_OPA=1
Environment=SMHAI_OPA_BINARY=/opt/psynova-school-demo/services/safety/bin/opa
Environment=SMHAI_OPA_URL=http://127.0.0.1:8181
Environment=SMHAI_OPA_RUNTIME_DIR=/var/lib/psynova-school-safety/opa-runtime
Environment=SMHAI_REVIEW_DB=/var/lib/psynova-school-safety/reviews.sqlite
Environment=SMHAI_HF_HOME=/var/cache/psynova-school-safety/huggingface/hub
Environment=HF_HOME=/var/cache/psynova-school-safety/huggingface
Environment=HF_HUB_CACHE=/var/cache/psynova-school-safety/huggingface/hub
Environment=HF_HUB_OFFLINE=1
Environment=HF_HUB_DISABLE_IMPLICIT_TOKEN=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=HOME=/var/lib/psynova-school-safety
StateDirectory=psynova-school-safety
StateDirectoryMode=0750
ExecStartPre=/opt/psynova-school-demo/services/safety/venv/bin/python -c "import fastapi, httpx, nemoguardrails, presidio_analyzer, presidio_anonymizer, torch, transformers; assert '+cpu' in torch.__version__; assert not torch.cuda.is_available()"
ExecStart=/opt/psynova-school-demo/services/safety/venv/bin/python -m safety_engine.api.app
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077
LimitCORE=0
MemoryMax=5G
MemorySwapMax=0
CPUQuota=150%
TasksMax=128
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
ReadOnlyPaths=/var/cache/psynova-school-safety/huggingface
ReadWritePaths=/var/lib/psynova-school-safety

[Install]
WantedBy=multi-user.target
