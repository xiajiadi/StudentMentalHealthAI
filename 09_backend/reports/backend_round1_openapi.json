  "components": {
    "schemas": {
      "AssessmentStartRequest": {
        "properties": {
          "subject_id": {
            "type": "string",
            "pattern": "^SUBJ_[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Subject Id"
          },
          "instrument_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Instrument Id"
          },
          "instrument_version": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Instrument Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "subject_id",
          "instrument_id",
          "instrument_version"
        ],
        "title": "AssessmentStartRequest"
      },
      "CompleteRequest": {
        "properties": {},
        "additionalProperties": false,
        "type": "object",
        "title": "CompleteRequest"
      },
      "GenerationRequest": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "generation.v1",
            "title": "Schema Version"
          },
          "generation_id": {
            "type": "string",
            "pattern": "^GEN_[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Generation Id"
          },
          "assessment_id": {
            "type": "string",
            "pattern": "^ASSESS_[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Assessment Id"
          },
          "subject_id": {
            "type": "string",
            "pattern": "^SUBJ_[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Subject Id"
          },
          "target_role": {
            "type": "string",
            "enum": [
              "student",
              "teacher",
              "parent",
              "admin"
            ],
            "title": "Target Role"
          },
          "purpose": {
            "type": "string",
            "const": "education_support",
            "title": "Purpose"
          },
          "language": {
            "type": "string",
            "minLength": 2,
            "title": "Language"
          },
          "safety_mode": {
            "type": "string",
            "enum": [
              "standard",
              "restricted"
            ],
            "title": "Safety Mode"
          },
          "retrieval": {
            "$ref": "#/components/schemas/RetrievalRef"
          },
          "prompt_ref": {
            "$ref": "#/components/schemas/PromptRef"
          },
          "model_policy": {
            "$ref": "#/components/schemas/ModelPolicy"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "generation_id",
          "assessment_id",
          "subject_id",
          "target_role",
          "purpose",
          "language",
          "safety_mode",
          "retrieval",
          "prompt_ref",
          "model_policy"
        ],
        "title": "GenerationRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "ModelPolicy": {
        "properties": {
          "model_id": {
            "type": "string",
            "pattern": "^MODEL_[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Model Id"
          },
          "provider_class": {
            "type": "string",
            "enum": [
              "local",
              "mock"
            ],
            "title": "Provider Class"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model_id",
          "provider_class"
        ],
        "title": "ModelPolicy"
      },
      "PromptRef": {
        "properties": {
          "prompt_id": {
            "type": "string",
            "pattern": "^PROMPT_[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Prompt Id"
          },
          "prompt_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "title": "Prompt Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prompt_id",
          "prompt_version"
        ],
        "title": "PromptRef"
      },
      "ResponseEvent": {
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^ITEM_[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Item Id"
          },
          "response": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ],
            "title": "Response"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "item_id",
          "response"
        ],
        "title": "ResponseEvent"
      },
      "RetrievalRef": {
        "properties": {
          "retrieval_id": {
            "type": "string",
            "pattern": "^RETR_[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Retrieval Id"
          },
          "chunk_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Chunk Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "retrieval_id",
          "chunk_ids"
        ],
        "title": "RetrievalRef"
      },
      "RetrievalRequest": {
        "properties": {
          "assessment_id": {
            "type": "string",
            "pattern": "^ASSESS_[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Assessment Id"
          },
          "target_role": {
            "type": "string",
            "enum": [
              "student",
              "teacher",
              "parent",
              "admin"
            ],
            "title": "Target Role"
          },
          "query": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Query"
          },
          "top_k": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "assessment_id",
          "target_role",
          "query"
        ],
        "title": "RetrievalRequest"
      },
      "ReviewRequest": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
