{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://student-mental-health-ai.invalid/schemas/generation.v1.schema.json",
  "x-contract-release": "v0.1.0",
  "x-contract-status": "FROZEN",
  "title": "Generation v1 request or result",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generation_id",
        "assessment_id",
        "subject_id",
        "target_role",
        "purpose",
        "language",
        "safety_mode",
        "retrieval",
        "prompt_ref",
        "model_policy"
      ],
      "properties": {
        "schema_version": {
          "const": "generation.v1"
        },
        "generation_id": {
          "type": "string",
          "pattern": "^GEN_[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "assessment_id": {
          "type": "string",
          "pattern": "^ASSESS_[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "subject_id": {
          "type": "string",
          "pattern": "^SUBJ_[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "target_role": {
          "$ref": "#/$defs/role"
        },
        "purpose": {
          "const": "education_support"
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "safety_mode": {
          "enum": [
            "standard",
            "restricted"
          ]
        },
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "retrieval_id",
            "chunk_ids"
          ],
          "properties": {
            "retrieval_id": {
              "type": "string",
              "pattern": "^RETR_[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "chunk_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^CHUNK_[A-Za-z0-9][A-Za-z0-9_.-]*$"
              }
            }
          }
        },
        "prompt_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt_id",
            "prompt_version"
          ],
          "properties": {
            "prompt_id": {
              "type": "string",
              "pattern": "^PROMPT_[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "prompt_version": {
              "$ref": "#/$defs/version_label"
            }
          }
        },
        "model_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_id",
            "provider_class"
          ],
          "properties": {
            "model_id": {
              "type": "string",
              "pattern": "^MODEL_[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "provider_class": {
              "enum": [
                "local",
                "mock"
              ]
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generation_id",
        "status",
        "target_role",
        "content",
        "safety",
        "provenance",
        "review",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": "generation.v1"
        },
        "generation_id": {
          "type": "string",
          "pattern": "^GEN_[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "status": {
          "enum": [
            "requested",
            "safety_blocked",
            "generating",
            "generated",
            "needs_review",
            "approved",
            "rejected"
          ]
        },
        "target_role": {
          "$ref": "#/$defs/role"
        },
        "content": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/content"
            }
          ]
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "precheck",
            "postcheck",
            "reason_codes",
            "human_review_required"
          ],
          "properties": {
            "precheck": {
              "$ref": "#/$defs/safety_status"
            },
            "postcheck": {
              "$ref": "#/$defs/safety_status"
            },
            "reason_codes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_.-]+$"
              }
            },
            "human_review_required": {
              "type": "boolean"
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assessment_id",
            "retrieval_id",
            "prompt_id",
            "prompt_version",
            "model_id",
            "model_version",
            "runtime_version"
          ],
          "properties": {
            "assessment_id": {
              "type": "string",
              "pattern": "^ASSESS_[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "retrieval_id": {
              "type": "string",
              "pattern": "^RETR_[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "prompt_id": {
              "type": "string",
              "pattern": "^PROMPT_[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "prompt_version": {
              "$ref": "#/$defs/version_label"
            },
            "model_id": {
              "type": "string",
              "pattern": "^MODEL_[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "model_version": {
              "$ref": "#/$defs/version_label"
            },
            "runtime_version": {
              "$ref": "#/$defs/version_label"
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reviewer_id",
            "reviewed_at"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "approved",
                "rejected",
                "not_required"
              ]
            },
            "reviewer_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "reviewed_at": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "safety_blocked"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "type": "null"
              },
              "safety": {
                "properties": {
                  "human_review_required": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "type": "object"
              },
              "review": {
                "properties": {
                  "status": {
                    "const": "approved"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "safety": {
                "properties": {
                  "human_review_required": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "safety_blocked",
                  "needs_review"
                ]
              }
            }
          }
        }
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "observations",
        "suggestions",
        "disclaimer"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "suggestions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/suggestion"
          }
        },
        "disclaimer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source_chunk_ids"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_chunk_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CHUNK_[A-Za-z0-9][A-Za-z0-9_.-]*$"
          }
        }
      }
    },
    "role": {
      "enum": [
        "student",
        "teacher",
        "parent",
        "admin"
      ]
    },
    "safety_status": {
      "enum": [
        "passed",
        "warn",
        "blocked",
        "needs_review"
      ]
    },
    "version_label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    }
  }
}
