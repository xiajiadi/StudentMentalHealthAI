{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://student-mental-health-ai.invalid/schemas/knowledge.v1.schema.json",
  "x-contract-release": "v0.1.0",
  "x-contract-status": "FROZEN",
  "title": "Knowledge v1 document or chunk",
  "oneOf": [
    {
      "$ref": "#/$defs/document"
    },
    {
      "$ref": "#/$defs/chunk"
    }
  ],
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "document_id",
        "title",
        "source",
        "language",
        "population_scope",
        "category",
        "rights_status",
        "review_status",
        "version",
        "content_hash",
        "ingestion"
      ],
      "properties": {
        "schema_version": {
          "const": "knowledge.v1"
        },
        "document_id": {
          "type": "string",
          "pattern": "^KB_[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "population_scope": {
          "$ref": "#/$defs/scope_array"
        },
        "category": {
          "enum": [
            "policy",
            "theory",
            "practice_guidance",
            "referral",
            "other"
          ]
        },
        "rights_status": {
          "$ref": "#/$defs/rights_status"
        },
        "review_status": {
          "$ref": "#/$defs/review_status"
        },
        "version": {
          "$ref": "#/$defs/version_label"
        },
        "content_hash": {
          "$ref": "#/$defs/content_hash"
        },
        "ingestion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pipeline_version",
            "ingested_at"
          ],
          "properties": {
            "pipeline_version": {
              "$ref": "#/$defs/version_label"
            },
            "ingested_at": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "chunk_id",
        "document_id",
        "text",
        "content_type",
        "location",
        "citation",
        "population_scope",
        "role_scope",
        "risk_scope",
        "review_status",
        "rights_status",
        "content_hash",
        "embedding"
      ],
      "properties": {
        "schema_version": {
          "const": "knowledge.v1"
        },
        "chunk_id": {
          "type": "string",
          "pattern": "^CHUNK_[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "document_id": {
          "type": "string",
          "pattern": "^KB_[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "content_type": {
          "enum": [
            "source_excerpt",
            "approved_summary"
          ]
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "section",
            "page_start",
            "page_end"
          ],
          "properties": {
            "section": {
              "type": "string",
              "minLength": 1
            },
            "page_start": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "page_end": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "citation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "organization",
            "locator"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "organization": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "population_scope": {
          "$ref": "#/$defs/scope_array"
        },
        "role_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "student",
              "teacher",
              "parent",
              "admin"
            ]
          }
        },
        "risk_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "normal",
              "attention",
              "high",
              "crisis"
            ]
          }
        },
        "review_status": {
          "$ref": "#/$defs/review_status"
        },
        "rights_status": {
          "$ref": "#/$defs/rights_status"
        },
        "content_hash": {
          "$ref": "#/$defs/content_hash"
        },
        "embedding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_id",
            "model_version",
            "status"
          ],
          "properties": {
            "model_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^MODEL_[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "model_version": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "status": {
              "enum": [
                "not_indexed",
                "indexed",
                "failed"
              ]
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization",
        "author",
        "published_year",
        "source_type",
        "locator"
      ],
      "properties": {
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1900
        },
        "source_type": {
          "enum": [
            "government",
            "academic",
            "textbook",
            "practice_guidance",
            "local_protocol",
            "other"
          ]
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "file_name"
          ],
          "properties": {
            "url": {
              "type": [
                "string",
                "null"
              ]
            },
            "file_name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "scope_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rights_status": {
      "enum": [
        "verified",
        "unknown",
        "restricted"
      ]
    },
    "review_status": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "version_label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9._:-]+$"
    }
  }
}
