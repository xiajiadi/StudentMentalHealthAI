{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://student-mental-health-ai.invalid/schemas/assessment.v1.schema.json",
  "x-contract-release": "v0.1.0",
  "x-contract-status": "FROZEN",
  "title": "Assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "subject_id",
    "instrument",
    "population_scope",
    "status",
    "dimensions",
    "risk",
    "response_summary",
    "provenance",
    "timestamps"
  ],
  "properties": {
    "schema_version": {
      "const": "assessment.v1"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^ASSESS_[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^SUBJ_[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument_id",
        "version"
      ],
      "properties": {
        "instrument_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "population_scope": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "created",
        "in_progress",
        "completed",
        "abandoned",
        "invalid"
      ]
    },
    "dimensions": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/dimension"
        }
      },
      "additionalProperties": false
    },
    "risk": {
      "$ref": "#/$defs/risk"
    },
    "response_summary": {
      "$ref": "#/$defs/response_summary"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "timestamps": {
      "$ref": "#/$defs/timestamps"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "timestamps": {
            "properties": {
              "completed_at": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk": {
            "properties": {
              "level": {
                "enum": [
                  "high",
                  "crisis"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "risk": {
            "properties": {
              "need_human_review": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theta",
        "se",
        "score",
        "band",
        "interpretation_status",
        "items_answered"
      ],
      "properties": {
        "theta": {
          "type": [
            "number",
            "null"
          ]
        },
        "se": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "band": {
          "enum": [
            "normal",
            "attention",
            "high",
            "unknown"
          ]
        },
        "interpretation_status": {
          "enum": [
            "estimated",
            "insufficient_data",
            "not_scored"
          ]
        },
        "items_answered": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "need_human_review",
        "reason_codes",
        "ruleset_id"
      ],
      "properties": {
        "level": {
          "enum": [
            "normal",
            "attention",
            "high",
            "crisis"
          ]
        },
        "need_human_review": {
          "type": "boolean"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_.-]+$"
          }
        },
        "ruleset_id": {
          "type": "string",
          "pattern": "^RULESET_[A-Za-z0-9][A-Za-z0-9_.-]*$"
        }
      }
    },
    "response_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items_answered",
        "duration_seconds"
      ],
      "properties": {
        "items_answered": {
          "type": "integer",
          "minimum": 0
        },
        "duration_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_adapter",
        "adapter_version",
        "cat_engine_version",
        "item_bank_version"
      ],
      "properties": {
        "source_adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "cat_engine_version": {
          "type": "string",
          "minLength": 1
        },
        "item_bank_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "completed_at"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "minLength": 1
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    }
  }
}
