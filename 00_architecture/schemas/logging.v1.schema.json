{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://student-mental-health-ai.invalid/schemas/logging.v1.schema.json",
  "x-contract-release": "v0.1.0",
  "x-contract-status": "FROZEN",
  "title": "Structured logging v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timestamp",
    "level",
    "event",
    "component",
    "request_id",
    "trace_id",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "const": "logging.v1"
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ]
    },
    "event": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_.-]+$"
    },
    "component": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^REQ_[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^TRACE_[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "outcome": {
      "enum": [
        "started",
        "success",
        "warning",
        "blocked",
        "failed"
      ]
    },
    "duration_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "entity_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "type": "string",
          "pattern": "^ASSESS_[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "retrieval_id": {
          "type": "string",
          "pattern": "^RETR_[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "generation_id": {
          "type": "string",
          "pattern": "^GEN_[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "report_id": {
          "type": "string",
          "pattern": "^REPORT_[A-Za-z0-9][A-Za-z0-9_.-]*$"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "dependency": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_.-]+$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
